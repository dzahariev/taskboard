<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:f="sap.ui.layout.form"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core">
	<Dialog
		id="createDialog"
		title="Create Task"
		contentWidth="32rem"
		stretch="{device>/system/phone}">
		<content>
			<VBox class="sapUiSmallMargin" id="formContainer">
				<f:SimpleForm id="CreateTaskForm" editable="true" layout="ColumnLayout" columnsM="1" columnsL="1" columnsXL="1">
					<f:content>
						<Label text="Kind" />
						<Select
							id="KIND_COMBOBOX"
							width="100%"
							forceSelection="false"
							items="{
								path: '/kinds',
								sorter: { path: 'name' }
							}"
							change="onKindChange">
							<core:Item key="{name}" text="{name}" />
						</Select>
						<Label text="Resource" />
						<Input id="SOURCE_INPUT" />
						<Label text="Preset" />
						<Select
							id="PRESET_COMBOBOX"
							width="100%"
							forceSelection="true"
							items="{
								path: 'presets',
								sorter: { path: 'key' },
								templateShareable: false
							}">
							<core:Item key="{key}" text="{name}" />
						</Select>
					</f:content>
				</f:SimpleForm>
			</VBox>
		</content>
		<footer>
			<Toolbar>
				<content>
					<ToolbarSpacer />
					<Button type="Accept" text="Save" press=".onSave" />
					<Button id="Reject" text="Reject" type="Reject" press=".closeDialog" ariaHasPopup="Dialog" />
				</content>
			</Toolbar>
		</footer>
	</Dialog>
</core:FragmentDefinition>