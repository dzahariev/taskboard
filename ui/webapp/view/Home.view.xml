<mvc:View
	controllerName="com.zahariev.taskboard.controller.Home"
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:mvc="sap.ui.core.mvc">
	<Page showHeader="false">
		<landmarkInfo>
			<PageAccessibleLandmarkInfo
				rootRole="Region"
				rootLabel="{i18n>Home_rootLabel}"
				contentRole="Main"
				contentLabel="{i18n>Home_contentLabel}"/>
		</landmarkInfo>
		<content>
			<Table
				id="tasksTable"
				items="{path:'/tasks', templateShareable: false}"
				fixedLayout="false">
				<headerToolbar>
					<Toolbar>
						<Title
							text="{i18n>tasksTableHeader}"
							level="H3"/>
						<ToolbarSpacer/>
						<Button
							id="new"
							icon="sap-icon://add-document"
							press=".createNew"
							tooltip="{i18n>new}"/>
						<Button
							id="refresh"
							icon="sap-icon://refresh"
							press=".loadData"
							tooltip="{i18n>refresh}"/>
					</Toolbar>
				</headerToolbar>
				<columns>
					<Column width="1%">
						<Text text=""/>
					</Column>
					<Column width="1%">
						<Text text=""/>
					</Column>
					<Column width="35%">
						<Text text=""/>
					</Column>
					<Column width="20%">
						<Text text=""/>
					</Column>
					<Column width="auto">
						<Text text=""/>
					</Column>
					<Column width="1%">
						<Text text=""/>
					</Column>
				</columns>
				<items>
					<ColumnListItem>
						<cells>
							<core:Icon src="{parts: ['kind'], formatter: '.kindIcon'}"/>
							<core:Icon src="{parts: ['status'], formatter: '.statusIcon'}"/>
							<Text text="{source}" renderWhitespace="true"/>
							<Text text="{parts: ['kind', 'preset'], formatter: '.presetText'}" renderWhitespace="true"/>
							<ProgressIndicator
								class="sapUiSmallMarginBottom"
								percentValue="{progress}"
								displayValue="{progress}%"
								showValue="true"
								state="None" />
							<Button icon="sap-icon://delete" tooltip="{i18n>delete}" press=".delete"/>
						</cells>
					</ColumnListItem>
				</items>
			</Table>
		</content>
	</Page>
</mvc:View>